# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch / diagnostic files (never tracked — personal paths, probes, notes)
.scratch/

# OS
.DS_Store
Thumbs.db

# Project data (runtime-generated cache/state — never tracked; regenerates on run)
data/
.omo/

# Logs
*.log

# Board build artifacts (regenerated by CI publish step)
board.html

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Hermes runtime state (profiles, cache, bookbag, plans — regenerates on run)
.hermes/

# Codegraph index (regenerates via `codegraph init`)
.codegraph/

# CE workflow artifacts (generated by scripts/ce_runner.py)
docs/solutions/
# CocoIndex index store (regenerates via `uv run cocoindex update main.py`)
scripts/prior_solutions/lancedb_data/
scripts/prior_solutions/cocoindex_store/
# CocoIndex runtime cache
.cocoindex_code/

# Entire session tracking (logs can carry prompt content — never commit)
.entire/
