# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch / diagnostic files (never tracked — personal paths, probes, notes)
.scratch/

# OS
.DS_Store
Thumbs.db

# Project data (runtime-generated cache/state — never tracked; regenerates on run)
data/
!data/
data/*
!data/crew_runs.json
# Curated vault: track the contract (manifest + README), never the notes.
# data/ itself stays ignored; only these contract files are un-ignored.
!data/vault/
!data/vault/.vault_manifest.json
!data/vault/README.md
data/vault/school/
data/vault/docs/
data/vault/anchors/
data/vault/roles/
.omo/

# Logs
*.log

# Board build artifacts (regenerated by CI publish step)
board.html

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Hermes runtime state (profiles, cache, bookbag, plans — regenerates on run)
.hermes/

# Codegraph index (regenerates via `codegraph init`)
.codegraph/

# CE workflow artifacts (generated by scripts/ce_runner.py)
docs/solutions/
# CocoIndex index store (regenerates via `uv run cocoindex update main.py`)
scripts/prior_solutions/lancedb_data/
scripts/prior_solutions/cocoindex_store/
# CocoIndex runtime cache
.cocoindex_code/

# Entire session tracking (logs can carry prompt content — never commit)
.entire/

# Secret environment files — NEVER track. Real OMNIROUTE_API_KEY lives in
# school-core/.env (loaded via python-dotenv in executor.py). .env.example is
# the committed, placeholder-only template. A previously-committed real key
# had to be rotated, so keep .env strictly ignored.
.env
.env.*
!.env.example

# envit context materialization — manifest (envit.json) + lockfile (envit.lock.json)
# are committed; the materialized .envit/ store is regenerated per-machine.
.envit/

# Durable local tool binaries (envit CLI, ripwire CLI + staged skills) — never
# track binaries; SHA-verified installs live under data/tools (chmod 700).
data/tools/
