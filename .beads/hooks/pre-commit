#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v1.1.0 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.1.0 ---

# --- BEGIN OUTER-LOOP GATE ---
# The outer loop (issue -> PR -> review) is only enforced if a gate actually
# runs. `bd hooks run pre-commit` above is inert unless `bd config hooks` is
# set, so this section is the gate.
#
# WHY `bd lint` AND NOT AN EXIT-CODE GUARD ON A QUERY:
#   The beads query subcommand exits 0 and prints "No issues found" when
#   nothing matches, and exits 1 only for a malformed expression. Its exit
#   code therefore cannot distinguish "found" from "not found", so a guard
#   written as `<query> 'spec=X' || fail` PASSES while matching nothing --
#   fail-open. `bd lint` exits non-zero when an open work item is missing a
#   required section, which is a real signal about a real object.
#   The trap is pinned by tests/test_outer_loop_gate.py; do not reintroduce
#   a query-exit-code or pipe-to-grep guard here.
#
# GATED TYPES: task, bug, feature. `decision` and `epic` are containers, not
# work, and may legitimately be unresolved.
#
# SKIP: set BEADS_SKIP_LINT=1 for a deliberate bypass (e.g. an emergency
# revert). The bypass is explicit and visible in the commit environment,
# unlike a silently absent gate.
if command -v bd >/dev/null 2>&1 && [ "${BEADS_SKIP_LINT:-0}" != "1" ]; then
  _gate_failed=0
  for _t in task bug feature; do
    if ! _lint_out=$(bd lint --type "$_t" 2>&1); then
      echo >&2 "outer-loop gate: bd lint failed for work type '$_t':"
      echo >&2 "$_lint_out"
      _gate_failed=1
    fi
  done
  if [ $_gate_failed -ne 0 ]; then
    echo >&2 "outer-loop gate: refusing the commit. Fix the sections above, or set BEADS_SKIP_LINT=1 to bypass deliberately."
    exit 1
  fi
fi
# --- END OUTER-LOOP GATE ---

# --- BEGIN UB-MODE QUALITY GATE ---
# Runs crapper (complexity) and dryer (duplication) on changed files.
# Skip with UB_SKIP=1 for emergency bypasses.
if [ "${UB_SKIP:-0}" != "1" ]; then
  _ub_tools_missing=0
  if ! command -v crapper >/dev/null 2>&1; then
    echo >&2 "ub-mode: crapper not found — install with: pip install -e ~/crapper"
    _ub_tools_missing=1
  fi
  if ! command -v dryer >/dev/null 2>&1; then
    echo >&2 "ub-mode: dryer not found — install with: pip install -e ~/dryer"
    _ub_tools_missing=1
  fi
  if [ $_ub_tools_missing -eq 0 ]; then
    export PATH="/Users/brandonbennett/Library/Python/3.14/bin:$PATH"
    echo "running ub-mode quality gate (crapper + dryer)..."
    if ! crapper --no-coverage --threshold 10 --changed src/ tests/; then
      echo >&2 "ub-mode: crapper failed — CRAP score exceeds threshold"
      exit 1
    fi
    if ! dryer --threshold 0.82 --changed src/ tests/; then
      echo >&2 "ub-mode: dryer found duplicate candidates at threshold 0.82"
      exit 1
    fi
    echo "ub-mode quality gate passed"
  fi
fi

# --- BEGIN TDD GATE ---
# New source files must have corresponding tests.
# Skip with TDDSKIP=1 for deliberate bypass.
if [ "${TDDSKIP:-0}" != "1" ]; then
  if [ -f scripts/check_tdd.py ]; then
    python3 scripts/check_tdd.py || exit 1
  fi
fi
# --- END TDD GATE ---
