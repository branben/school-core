# school-core environment template
# Copy to .env and fill in the required keys.
# Required keys are uncommented; optional keys are commented with a note.

# --- Required: model provider ---
# The Nous inference API is the default provider.
NOUS_API_KEY=your_nous_api_key_here
NOUS_MODEL=meituan/longcat-2.0:free

# --- Required: GitHub ---
# Used for PR creation and issue fetching.
GITHUB_TOKEN=your_github_token_here

# --- Optional: OmniRoute gateway ---
# Uncomment if you route model calls through OmniRoute instead of Nous directly.
# OMNIROUTE_API_KEY=your_api_key_here
# OMNIROUTE_BASE=http://localhost:20128/v1

# --- Optional: Engram ---
# Auto-detected if absent. Uncomment to override.
# ENGRAM_API_KEY=your_engram_key_here

# --- Optional: Beads (Dolt) ---
# Local-only credential for the Dolt issue tracker.
# BEADS_CREDENTIAL_KEY=

# --- Optional: AgentMail ---
# Used for verdict cards and issue alerts. Falls back to the first inbox on the key.
# AGENTMAIL_SCHOOL_INBOX=   # Agent-School control-plane inbox (verdict cards + human replies)
# AGENTMAIL_INBOX=          # legacy/override destination inbox
