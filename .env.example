# environment.example

# OmniRoute gateway
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_BASE=http://localhost:20128/v1

# Engram (optional — auto-detected if absent)
# ENGRAM_API_KEY=your_engram_key_here

# GitHub
GITHUB_TOKEN=your_github_token_here

# Candidate-bound source-diff publication (Phase 1 PR-correctness). DISABLED by
# default: a task carrying an exact candidate manifest is refused unless this is
# explicitly enabled, so the seam never silently falls back to the legacy
# patch-blob path. Only an operator opts in, and only after the disposable-VM
# phase qualifies production coding dispatch. No live provider write happens
# unless the candidate-bound gate authorizes an exact, teacher-approved,
# verified candidate.
# CANDIDATE_PR_ENABLED=1

# SmolMachines Cloud — hosted qualification probes ONLY (tests/test_smol_cloud_hosted_probes.py).
# Real key lives in .env, never in chat or source. Probes stay inert unless
# SCHOOL_CORE_HOSTED_PROBES=1 is also set explicitly.
# SMOL_CLOUD_TOKEN=smk_your_key_here
# SCHOOL_CORE_SMOL_CLOUD_IMAGE=registry.smolmachines.com/library/alpine@sha256:<64-hex-digest>
# SCHOOL_CORE_SMOL_CLOUD_SOURCE_TYPE=smolmachine  # image | smolmachine; only smolmachine boots under network:blocked

# Optional one-way Paperclip status mirror (disabled unless explicitly enabled).
# Set COMPANY_ID and PROJECT_ID from the selected Paperclip company/project;
# both must be UUIDs. No Paperclip task is created until the mirror is enabled.
# PAPERCLIP_API_URL=http://127.0.0.1:3100
# PAPERCLIP_COMPANY_ID=
# PAPERCLIP_PROJECT_ID=
# PAPERCLIP_API_KEY=  # optional only for Paperclip local_trusted mode
# SCHOOL_CORE_PAPERCLIP_MIRROR=0

# Beads (Dolt) - local only
# BEADS_CREDENTIAL_KEY=

# AgentMail (optional)
# AGENTMAIL_SCHOOL_INBOX=   # Agent-School control-plane inbox (verdict cards +
#                           # human replies). Falls back to AGENTMAIL_INBOX, then
#                           # the first inbox on the key.
# AGENTMAIL_INBOX=          # legacy/override destination inbox
