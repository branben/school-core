#!/usr/bin/env bash
# FirstMate launch wrapper for Hermes crewmates.
# $1 = encoded brief (from firstmate operational input)
#
# Capability propagation is task-scoped through FM_AGENT_* variables. Hermes's
# native profile flag is intentionally not used: the local CLI previously had
# a profile/skills-snapshot compatibility bug. Instead, the wrapper loads the
# validated committed SOUL.md into the initial prompt and applies the validated
# native Hermes toolset policy.
set -euo pipefail

MAX_TURNS="${FM_AGENT_MAX_TURNS:-16}"
if [[ ! "$MAX_TURNS" =~ ^[1-9][0-9]*$ ]]; then
  echo "hermes-fm-wrapper: invalid max-turns policy" >&2
  exit 78
fi
HERMES="${HERMES:-$(command -v hermes 2>/dev/null || true)}"
if [[ -z "$HERMES" || ! -x "$HERMES" ]]; then
  echo "hermes-fm-wrapper: Hermes CLI is unavailable" >&2
  exit 78
fi
DEFAULT_TOOLSETS="agentmail,bfl,clarify,cronjob,delegation,engram,file,kanban,memory,session_search,skills,terminal,todo,web,codegraph,cocoindex,roblox-studio,serena,serena-roblox"
BRIEF="${1:-}"
PROFILE="${FM_AGENT_PROFILE:-}"
if [[ -n "${FM_AGENT_CAPABILITY_VERSION:-}" && -z "${FM_AGENT_TOOLSETS:-}" ]]; then
  echo "hermes-fm-wrapper: capability policy has no Hermes toolsets" >&2
  exit 78
fi
TOOLSETS="${FM_AGENT_TOOLSETS:-$DEFAULT_TOOLSETS}"
SKILL_ANCHORS="${FM_AGENT_SKILL_ANCHORS:-}"
# The capability manifest owns this allowlist; the wrapper repeats it at the
# process boundary so a malformed env value cannot become an arbitrary Hermes
# CLI argument. Unknown values fail closed and let school-core use direct
# fallback rather than silently granting the broad default toolset.
if [[ ! "$TOOLSETS" =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ ]]; then
  echo "hermes-fm-wrapper: malformed toolset policy" >&2
  exit 78
fi
IFS=',' read -r -a TOOLSET_NAMES <<< "$TOOLSETS"
for toolset in "${TOOLSET_NAMES[@]}"; do
  case "$toolset" in
    agentmail|bfl|clarify|cronjob|delegation|engram|file|kanban|memory|session_search|skills|terminal|todo|web|codegraph|cocoindex|roblox-studio|serena|serena-roblox) ;;
    *)
      echo "hermes-fm-wrapper: invalid toolset policy" >&2
      exit 78
      ;;
  esac
done

INPUT="$BRIEF"
if [[ -n "$PROFILE" ]]; then
  if [[ ! "$PROFILE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "hermes-fm-wrapper: invalid profile name" >&2
    exit 78
  fi

  PERSONA_FILE=""
  for candidate in \
    "$PWD/config/profiles/$PROFILE/SOUL.md" \
    "$HOME/.hermes/profiles/$PROFILE/SOUL.md"; do
    if [[ -r "$candidate" ]]; then
      PERSONA_FILE="$candidate"
      break
    fi
  done
  if [[ -z "$PERSONA_FILE" || ! -r "$PERSONA_FILE" ]]; then
    echo "hermes-fm-wrapper: persona '$PROFILE' is unavailable" >&2
    exit 78
  fi

  PERSONA=$(cat "$PERSONA_FILE")
  printf -v INPUT '%s\n\n---\n\n%s' "$PERSONA" "$INPUT"
fi

if [[ -n "$SKILL_ANCHORS" ]]; then
  printf -v INPUT '%s\n\n---\n\nSchool capability anchors (requested policy; not proof of tool use):\n%s' "$INPUT" "$SKILL_ANCHORS"
fi

# Use query mode, not interactive stdin mode. In an Orca terminal, stdin is
# composer input and is not guaranteed to be submitted; query mode starts the
# Hermes turn immediately and returns a bounded process result to FirstMate.
# Capture the exit code: it feeds the deterministic terminal handshake below.
set +e
"$HERMES" -p "$PROFILE" --cli --accept-hooks --toolsets "$TOOLSETS" chat \
  --query "$INPUT" --yolo --quiet --max-turns "$MAX_TURNS" 2>/tmp/hermes_stderr.log
HERMES_EXIT=$?
set -e

# U10 deterministic terminal handshake: the supervised launch contract requires
# a terminal status line (done/failed/blocked/needs-decision). When Hermes ends
# without one — the observed idle-scout failure where the crew sat in a
# conversational state and never wrote report.md or a status line — record a
# bounded failure on the EXACT supervised status path so the supervisor reaches
# a terminal state immediately instead of polling to the full timeout. This
# records the process outcome; it never fabricates a passing report (a pass
# still requires the crew's own report.md + done: identity evidence).
if [[ -n "${FM_STATUS_FILE:-}" ]]; then
  if mkdir -p "$(dirname "$FM_STATUS_FILE")" 2>/dev/null; then
    TERMINAL=""
    MIDWORK=""
    if [[ -f "$FM_STATUS_FILE" ]]; then
      LAST_LINE="$(tail -n 1 "$FM_STATUS_FILE" 2>/dev/null | sed 's/^[[:space:]]*//' || true)"
      case "$LAST_LINE" in
        done:*|failed:*|blocked:*|needs-decision:*) TERMINAL="yes" ;;
      esac
      # Tri-state: any working:/resolved: line without a terminal = mid-work
      case "$LAST_LINE" in
        working:*|resolved:*) MIDWORK="yes" ;;
      esac
      # Also check for mid-work anywhere in the file (not just last line)
      if [[ -z "$MIDWORK" && -z "$TERMINAL" ]]; then
        if grep -qE '^(working|resolved):' "$FM_STATUS_FILE" 2>/dev/null; then
          MIDWORK="yes"
        fi
      fi
    fi
    if [[ -z "$TERMINAL" ]]; then
      if [[ -n "$MIDWORK" ]]; then
        printf 'blocked: hermes-exit-%s-mid-work\n' "$HERMES_EXIT" >> "$FM_STATUS_FILE" \
          || echo "hermes-fm-wrapper: could not write blocked handshake to $FM_STATUS_FILE" >&2
      elif [[ -f "$FM_STATUS_FILE" && -s "$FM_STATUS_FILE" ]]; then
        printf 'failed: hermes-exit-%s-no-terminal-status\n' "$HERMES_EXIT" >> "$FM_STATUS_FILE" \
          || echo "hermes-fm-wrapper: could not write failed handshake to $FM_STATUS_FILE" >&2
      else
        printf 'failed: hermes-exit-%s-no-output\n' "$HERMES_EXIT" >> "$FM_STATUS_FILE" \
          || echo "hermes-fm-wrapper: could not write no-output handshake to $FM_STATUS_FILE" >&2
      fi
    fi
  else
    echo "hermes-fm-wrapper: cannot create status directory for $FM_STATUS_FILE" >&2
  fi
fi

exit "$HERMES_EXIT"
